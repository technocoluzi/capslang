#include <winver.h>

1 ICON "assets/capslang.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "technocoluzi"
            VALUE "FileDescription",  "CapsLang - switch input language with Caps Lock"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "capslang"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "capslang.exe"
            VALUE "ProductName",      "CapsLang"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
