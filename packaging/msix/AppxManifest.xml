<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build.

  Identity/Name and Identity/Publisher must match what Partner Center assigns
  once the app name is reserved; build-msix.ps1 substitutes them, along with
  the version, so this file stays the single source of truth.

  Two things here are load-bearing:

  * runFullTrust. CapsLang is a plain Win32 program that installs a
    system-wide keyboard hook. Nothing in the sandboxed app model can do that,
    and the capability is what tells Windows to run it as an ordinary desktop
    process.

  * windows.startupTask. A packaged app cannot start itself at sign-in through
    the Run key, because writes there are virtualised into the package's own
    hive, so the platform wants this instead. Enabled="true" starts CapsLang
    on first sign-in after install; from then on the user owns the setting in
    Settings, Apps, Startup.

  (Note for editors: XML comments cannot contain a double hyphen, so this
  file avoids them entirely.)
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CapsLang</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Switch keyboard input language with the Caps Lock key.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="CapsLang" Executable="capslang.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="CapsLang"
        Description="Switch keyboard input language with the Caps Lock key."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension
          Category="windows.startupTask"
          Executable="capslang.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="CapsLangStartup" Enabled="true" DisplayName="CapsLang" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
